# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# PostHog (use eu.i.posthog.com if your project is on the EU cloud)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google Kalender (OAuth-Client aus der Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 zufällige Bytes, base64 – verschlüsselt die Google-Tokens in der Datenbank.
# Erzeugen mit: openssl rand -base64 32
KALENDER_TOKEN_SCHLUESSEL=

# KI (Mistral, OpenAI-kompatible API) – nur serverseitig, NIE mit NEXT_PUBLIC_!
MISTRAL_API_KEY=
KI_BASIS_URL=https://api.mistral.ai/v1
# Standardmodell für alles
KI_MODELL=mistral-small-latest
# optional: eigenes Modell für den Assistenten bzw. für lange Texte (PDF, Transkript); leer = KI_MODELL
KI_MODELL_CHAT=
KI_MODELL_LANG=
# Audio (Voxtral 3, Stand Okt. 2026 – Modell-IDs vor Nutzung in der Mistral-Doku prüfen)
# z. B. voxtral-mini-transcribe-3
KI_AUDIO_STT_MODELL=
# z. B. voxtral-mini-tts-3-0
KI_AUDIO_TTS_MODELL=
# Preset-Stimme (voice_id, deutsch)
KI_AUDIO_STIMME=

# Kontingente pro Nutzer (Europe/Berlin); leer = Standardwert
# Text-Funktionen, Anfragen pro Tag (Standard 20; alter Name KI_TAGESLIMIT gilt weiter)
KI_LIMIT_TEXT_TAG=
# Assistent, Nachrichten pro Tag (Standard 40)
KI_LIMIT_CHAT_TAG=
# Diktieren + Transkription, Minuten pro Monat (Standard 120)
KI_LIMIT_AUDIO_MINUTEN_MONAT=
# Vorlesen, Zeichen pro Monat (Standard 50000)
KI_LIMIT_TTS_ZEICHEN_MONAT=
# Gesprächsmodus, Minuten pro Monat (Standard 30)
KI_LIMIT_GESPRAECH_MINUTEN_MONAT=
